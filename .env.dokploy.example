# Paste into the Dokploy environment editor. Apex belongs to the marketing
# deployment; the app lives on /app of the same origin.
APP_URL=https://vardum.example.com
MARKETING_UPSTREAM=vardum-marketing:80
CUSTOM_DOMAIN_TARGET=vardum.example.com
# open | allowlist | disabled
ORGANIZATION_CREATION=allowlist
ORGANIZATION_CREATOR_EMAILS=admin@example.com

POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters

MINIO_ROOT_USER=vardum
MINIO_ROOT_PASSWORD=replace-with-a-long-storage-password
S3_BUCKET=varda
S3_REGION=us-east-1
# Second Dokploy Domain, routed to service `minio` on container port 9000.
S3_PUBLIC_ENDPOINT=https://cdn.vardum.example.com

# Optional production SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
