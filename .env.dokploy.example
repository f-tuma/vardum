# Paste into the Dokploy environment editor. The apex belongs to the marketing
# deployment; the app lives on /app of the same origin.
APP_URL=https://vardum.com
CUSTOM_DOMAIN_TARGET=vardum.com
# open | allowlist | disabled
ORGANIZATION_CREATION=allowlist
ORGANIZATION_CREATOR_EMAILS=admin@vardum.com

POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters

# Object storage, on Hetzner here. Browsers upload straight to
# S3_PUBLIC_ENDPOINT with a presigned POST, so it must be publicly reachable.
S3_BUCKET=vardum-assets
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_PUBLIC_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=replace-with-the-bucket-access-key
S3_SECRET_ACCESS_KEY=replace-with-the-bucket-secret
S3_FORCE_PATH_STYLE=true

# Amazon S3 instead: empty both endpoints and name the bucket host as the
# upload origin.
# S3_REGION=eu-central-1
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# VITE_UPLOAD_ORIGINS=https://vardum-assets.s3.eu-central-1.amazonaws.com

# The marketing deployment's alias on dokploy-network. Leave it out until that
# application exists; the apex then serves the app itself.
# MARKETING_UPSTREAM=vardum-marketing:80

# No bucket of your own? Run one in the stack and give it a Domain on port 9000.
# COMPOSE_PROFILES=minio
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://cdn.vardum.com

# Optional production SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
