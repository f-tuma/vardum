# Paste into the Dokploy environment editor and replace all example values.
# Setup, storage options and upgrades: docs/dokploy.md.
# One HTTPS origin, no /app suffix. The app lives at /app/; the apex redirects
# there unless MARKETING_UPSTREAM points to a separate marketing site.
APP_URL=https://vardum.example.com
CUSTOM_DOMAIN_TARGET=vardum.example.com
# open | allowlist | disabled
ORGANIZATION_CREATION=allowlist
# Comma-separated administrator emails. Fresh allowlist bootstrap requires SMTP
# below: the account must verify its email before creating its first organization.
ORGANIZATION_CREATOR_EMAILS=admin@example.com

# Administrator / one-shot migrator only. Keep the existing value on upgrade.
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
# API + worker: distinct, URL-safe, at least 24 characters (openssl rand -hex 32).
POSTGRES_APP_PASSWORD=replace-with-a-different-runtime-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters

# Object storage, on Hetzner here. Browsers upload straight to
# S3_PUBLIC_ENDPOINT with a presigned POST, so it must be publicly reachable.
S3_BUCKET=vardum-assets
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_PUBLIC_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=replace-with-the-bucket-access-key
S3_SECRET_ACCESS_KEY=replace-with-the-bucket-secret
S3_FORCE_PATH_STYLE=true

# Amazon S3 instead: empty both endpoints so the SDK selects the regional bucket
# host. VITE_UPLOAD_ORIGINS only overrides development upload-origin validation.
# S3_REGION=eu-central-1
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# VITE_UPLOAD_ORIGINS=https://vardum-assets.s3.eu-central-1.amazonaws.com

# The marketing deployment's alias on dokploy-network. Leave it out until that
# application exists; the apex then redirects to /app/. The alias must be
# unique across applications using the same dokploy-network.
# MARKETING_UPSTREAM=your-marketing-alias:80

# No bucket of your own? Run RustFS in the stack and give it a Domain on port
# 9000. S3_CORS_ALLOWED_ORIGINS narrows who may upload from a browser; it
# defaults to * because restricting it breaks custom domains.
# COMPOSE_PROFILES=rustfs
# S3_ENDPOINT=http://rustfs:9000
# S3_PUBLIC_ENDPOINT=https://storage.example.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_CORS_ALLOWED_ORIGINS=*

# Configure a real SMTP provider for a fresh allowlist installation, invitations
# and password recovery. Blank values disable mail, including email verification.
# Port 587 uses STARTTLS when offered; port 465 requires SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional read-only /api/operations/{health,metrics} bearer token.
# Empty disables both endpoints. Generate with openssl rand -hex 32.
MONITORING_TOKEN=

# Resource budgets (MiB for storage, 24h to finalize an upload).
WORKSPACE_STORAGE_MB=10240
WORKSPACE_PENDING_UPLOADS=100
UPLOAD_PENDING_HOURS=24
API_MAX_INFLIGHT=128
DELIVERY_MAX_INFLIGHT=64
DELIVERY_REQUESTS_PER_SECOND=100
TRANSFORM_CONCURRENCY=2
TRANSFORM_QUEUE_LIMIT=8
TRANSFORM_MAX_OUTPUT_PIXELS=16000000
TRANSFORM_TIMEOUT_SECONDS=15
# Upload limits per kind, in MiB.
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_FILE_MB=100
API_MEMORY_LIMIT=2g
API_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=1g
WORKER_CPU_LIMIT=1
