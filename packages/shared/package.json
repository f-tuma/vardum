{
  "name": "@vardum/shared",
  "version": "0.4.1",
  "description": "Shared Vardum wire types and accepted-format tables",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/check-pack-manager.mjs && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-tuma/vardum.git",
    "directory": "packages/shared"
  },
  "homepage": "https://vardum.com",
  "bugs": {
    "url": "https://github.com/f-tuma/vardum/issues"
  }
}
