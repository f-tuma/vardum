# Vardum gateway for a deployment whose apex belongs to a separate marketing
# site. Baked into /etc/nginx/templates/ by the Dokploy target, so nginx substitutes
# ${API_UPSTREAM} and ${MARKETING_UPSTREAM} at container start.
#
# WHY ONE ORIGIN: the client calls the API with relative /api/* URLs and the
# Better Auth session cookie has to stay first-party. Splitting the client and
# the API across two hostnames is not a supported configuration. The marketing
# site has no such constraint — it is a separate deployment reached across
# dokploy-network — but it lives on the same origin so the apex can be a
# landing page while /app is the product.
#
# The self-hosted stack uses docker/nginx.conf instead, where `/` is the app.

# Docker service addresses change when containers are replaced. Keep upstream
# state shared between workers and refresh Docker DNS without an nginx reload.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 5s;

upstream vardum_api {
  zone vardum_api 64k;
  server ${API_UPSTREAM} resolve;
}

upstream vardum_marketing {
  zone vardum_marketing 64k;
  server ${MARKETING_UPSTREAM} resolve;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # The API owns its REST surface, asset delivery and the health probes. These
  # come first so nothing below can shadow them.
  location ^~ /api/ {
    proxy_pass http://vardum_api;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/(?:v|w)/ {
    proxy_pass http://vardum_api;
    proxy_buffering off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /health {
    proxy_pass http://vardum_api;
  }

  location = /ready {
    proxy_pass http://vardum_api;
  }

  # The built bundle, with the legacy /assets/ delivery prefix as the fallback.
  location ^~ /assets/ {
    try_files $uri @legacy_assets;
  }

  location @legacy_assets {
    proxy_pass http://vardum_api;
    proxy_buffering off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The routes the web client owns, listed rather than caught, so that the apex
  # can belong to something else. Keep in sync with apps/gateway/src/main.tsx: a
  # route missing here quietly serves the marketing 404 instead.
  location ~ ^/(?:app|account|organizations|workspaces|reset-password|accept-invitation|cli-login)(?:/|$) {
    try_files $uri /index.html;
  }

  # SPA try_files internally redirects to /index.html. Keep that target static
  # instead of allowing the catch-all marketing proxy to receive the redirect.
  location = /index.html {
    try_files $uri =404;
  }

  location = /favicon.svg {
    try_files $uri =404;
  }

  # Everything left over — the apex and whatever the marketing site puts beside
  # it. MARKETING_UPSTREAM is the marketing deployment's dokploy-network alias
  # as host:port, e.g. vardum-marketing:80. Left at its default it points at the
  # loopback server below, so an install with no marketing site yet opens the
  # app on the apex instead of failing to start.
  location / {
    proxy_pass http://vardum_marketing;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# The stand-in for a marketing site: the client itself, on a loopback port so
# the `/` handler above can reach it without recursing into its own server.
server {
  listen 127.0.0.1:8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }
}
