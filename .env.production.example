# Public URL served by the web container.
APP_URL=http://localhost:8080
CUSTOM_DOMAIN_TARGET=vardum.example.com
# open | allowlist | disabled
ORGANIZATION_CREATION=allowlist
ORGANIZATION_CREATOR_EMAILS=admin@example.com
WEB_PORT=8080

POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters

MINIO_ROOT_USER=vardum
MINIO_ROOT_PASSWORD=replace-with-a-long-storage-password
S3_BUCKET=varda
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Optional production SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
