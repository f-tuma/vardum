# Public URL served by the web container.
APP_URL=http://localhost:8080
# Public hostname that routes customer delivery domains to this install.
CUSTOM_DOMAIN_TARGET=vardum.example.com
# open | allowlist | disabled
ORGANIZATION_CREATION=allowlist
ORGANIZATION_CREATOR_EMAILS=admin@example.com
WEB_PORT=8080

# Administrator / one-shot migrator only. Keep the existing value on upgrade.
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
# API + worker: distinct, URL-safe, at least 24 characters (openssl rand -hex 32).
POSTGRES_APP_PASSWORD=replace-with-a-different-runtime-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters

# Object storage. Create the bucket yourself and use a key scoped to it.
# Browsers upload to S3_PUBLIC_ENDPOINT directly with a presigned POST, so it
# must be reachable from the public internet and it must be the origin the
# generated URL actually carries.
#
# Hetzner Object Storage (the location is both endpoint and region):
S3_BUCKET=vardum-assets
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_PUBLIC_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=replace-with-the-bucket-access-key
S3_SECRET_ACCESS_KEY=replace-with-the-bucket-secret
# Providers that do not serve virtual-hosted buckets need path style.
S3_FORCE_PATH_STYLE=true

# Amazon S3 instead: leave both endpoints empty so the SDK addresses the bucket
# itself, and name that host as the upload origin.
# S3_BUCKET=vardum-assets
# S3_REGION=eu-central-1
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# VITE_UPLOAD_ORIGINS=https://vardum-assets.s3.eu-central-1.amazonaws.com

# No object store of your own? `docker compose --profile rustfs ...` runs one
# beside the app; the keys above become its root credentials.
# S3_CORS_ALLOWED_ORIGINS narrows who may upload from a browser; it defaults to
# * because restricting it breaks custom domains.
# S3_ENDPOINT=http://rustfs:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# S3_CORS_ALLOWED_ORIGINS=*

# Optional production SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional read-only /api/operations/{health,metrics} bearer token.
# Empty disables both endpoints. Generate with openssl rand -hex 32.
MONITORING_TOKEN=
