{
  "name": "@vardum/api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/migrate.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "test": "NODE_ENV=test node --import tsx --test src/*.test.ts",
    "test:private-delivery": "node --import tsx --test integration/private-delivery.test.ts",
    "test:asset-pagination": "node --import tsx --test integration/asset-pagination.test.ts",
    "test:organization-verification": "node --import tsx --test integration/organization-verification.test.ts",
    "test:known-usages": "node --import tsx --test integration/known-usages.test.ts",
    "test:runtime-database": "node --import tsx --test integration/runtime-database.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/s3-presigned-post": "3.1110.0",
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@vardum/shared": "workspace:^",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.6",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "12.27.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.0",
    "auth": "1.7.1",
    "drizzle-kit": "^0.31.10"
  }
}
