{
  "name": "@vardum/cli",
  "version": "0.7.0",
  "description": "Developer-first CLI for syncing Vardum Vards into a project",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vardum": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/check-pack-manager.mjs && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@vardum/shared": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frgtn-dot-dev/vardum.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/frgtn-dot-dev/vardum/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/frgtn-dot-dev/vardum/issues"
  }
}
