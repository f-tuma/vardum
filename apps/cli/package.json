{
  "name": "@vardum/cli",
  "version": "0.2.0",
  "description": "Developer-first CLI for syncing Vardum Vards into a project",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vardum": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
