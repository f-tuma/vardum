{
  "name": "@vardum/mcp",
  "version": "0.3.0",
  "description": "MCP server for workspace-scoped Vardum assets and Vards",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vardum-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/check-pack-manager.mjs && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@vardum/shared": "workspace:^",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frgtn-dot-dev/vardum.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/frgtn-dot-dev/vardum/tree/main/apps/mcp#readme",
  "bugs": {
    "url": "https://github.com/frgtn-dot-dev/vardum/issues"
  }
}
