{
  "name": "vardum",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:frgtn-dot-dev/vardum",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "docker compose --profile storage up -d --wait && pnpm --filter @vardum/api db:migrate && pnpm -r --parallel dev",
    "dev:apps": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "vardum": "pnpm --filter @vardum/cli dev --"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@smithy/core": "3.31.1",
      "@smithy/fetch-http-handler": "5.6.13",
      "@smithy/node-http-handler": "4.9.13",
      "@smithy/types": "4.16.1",
      "@types/pg": "8.20.0",
      "jose": "6.2.8",
      "nanostores": "1.4.2",
      "rolldown": "1.2.4"
    }
  }
}