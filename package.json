{
  "name": "vardum",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:frgtn-dot-dev/vardum",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "docker compose --profile storage up -d --wait && pnpm --filter @vardum/shared build && pnpm --filter @vardum/api db:migrate && pnpm -r --parallel dev",
    "dev:apps": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "vardum": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
