POSTGRES_PORT=5432
DATABASE_URL=postgres://varda:varda@localhost:5432/varda
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CUSTOM_DOMAIN_TARGET=vite.f-tuma.dev
ORGANIZATION_CREATION=open
ORGANIZATION_CREATOR_EMAILS=
# Local email capture: SMTP on :1025, web UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Vardum <noreply@vardum.local>"
# Production SMTP authentication, when required:
# SMTP_USER=vardum
# SMTP_PASSWORD=replace-me
# Upload limits per kind, in MiB (files = anything that is not image/video)
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_FILE_MB=100

S3_REGION=us-east-1
S3_BUCKET=varda
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=varda
S3_SECRET_ACCESS_KEY=varda-secret
S3_FORCE_PATH_STYLE=true
VITE_UPLOAD_ORIGINS=http://localhost:9000
