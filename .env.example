# Local development only: copy to .env and run pnpm dev.
# For Dokploy use .env.dokploy.example; for standalone Docker use
# .env.production.example. Never reuse these local database/storage credentials.
POSTGRES_PORT=5432
DATABASE_URL=postgres://varda:varda@localhost:5432/varda
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRANSFORM_SECRET=replace-with-another-32-random-characters
# API/auth base URL, configured separately from the frontend origin.
BETTER_AUTH_URL=http://localhost:3000
# Explicit frontend origin for API CORS and auth: scheme, host and port must match.
# For remote development use e.g. https://dev.example.com:5173, then restart
# the development processes. Development mode does not add another remote origin.
WEB_URL=http://localhost:5173
# Optional public hostname for customer delivery domains; leave unset locally.
CUSTOM_DOMAIN_TARGET=
ORGANIZATION_CREATION=open
ORGANIZATION_CREATOR_EMAILS=
# Local email capture: SMTP on :1025, web UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Vardum <noreply@vardum.local>"
# Production SMTP authentication, when required:
# SMTP_USER=vardum
# SMTP_PASSWORD=replace-me
# Upload limits per kind, in MiB (files = anything that is not image/video)
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_FILE_MB=100

S3_REGION=us-east-1
S3_BUCKET=varda
S3_ENDPOINT=http://localhost:9000
# Optional separate browser upload endpoint (falls back to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=varda
S3_SECRET_ACCESS_KEY=varda-secret
S3_FORCE_PATH_STYLE=true
VITE_UPLOAD_ORIGINS=http://localhost:9000

# Optional read-only /api/operations/{health,metrics} bearer token.
# Empty disables both endpoints. Generate with openssl rand -hex 32.
MONITORING_TOKEN=
# Loopback-only worker health port; use another port for a second local worker.
WORKER_HEALTH_PORT=3001

# Resource budgets (MiB for storage, 24h to finalize an upload).
WORKSPACE_STORAGE_MB=10240
WORKSPACE_PENDING_UPLOADS=100
UPLOAD_PENDING_HOURS=24
API_MAX_INFLIGHT=128
DELIVERY_MAX_INFLIGHT=64
DELIVERY_REQUESTS_PER_SECOND=100
TRANSFORM_CONCURRENCY=2
TRANSFORM_QUEUE_LIMIT=8
TRANSFORM_MAX_OUTPUT_PIXELS=16000000
TRANSFORM_TIMEOUT_SECONDS=15
